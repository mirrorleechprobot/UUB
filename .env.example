BOT_TOKEN=YOUR_BOT_TOKEN
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
ADMIN_ID=123456789
# Optional extra admins (comma separated)
ADMIN_IDS=
# Log channel: bot ko channel me Admin banao (Post Messages). ID -100xxxxxxxxxx format me.
# (Bina -100 ke number daloge to bot khud theek kar lega.) Khali = log channel band.
LOG_CHANNEL_ID=-1001234567890
PORT=8080
DATA_DIR=/app/data
COOKIE_FILE=/app/cookies.txt
# Optional: Netscape cookies yahan paste karo (Koyeb secret env). Secret rakho.
COOKIES_TEXT=
# Optional: Referer jo kuch hosts mangte hain
DIRECT_REFERER=
PROGRESS_UPDATE_INTERVAL=10
MAX_RETRIES=3
# ---- speed tuning ----
MAX_CONCURRENT_JOBS=10
ARIA2_CONNECTIONS=16
ARIA2_DISK_CACHE_MB=64
CONCURRENT_FRAGMENTS=32
MAX_CONCURRENT_TRANSMISSIONS=6
# Upload: connections per big file x parts in flight per connection. Tune with /speedtest 400 <conns> <workers>
UPLOAD_CONNECTIONS=8
UPLOAD_WORKERS_PER_CONNECTION=4
UPLOAD_ADAPTIVE=true
# ---- FloodWait ----
# Waits up to FLOOD_SLEEP_THRESHOLD seconds are slept through automatically (same request is retried, no re-upload).
# Longer waits up to FLOOD_MAX_WAIT are waited out by the bot (user sees a message). Longer than that -> job fails cleanly.
FLOOD_SLEEP_THRESHOLD=600
FLOOD_MAX_WAIT=3600
# ---- multi bot (optional) ----
# Extra bot tokens, comma separated. EVERY helper must be Admin (Post Messages) of LOG_CHANNEL_ID, like the main bot.
# Helpers upload into the log channel and the main bot copies the file to the user (instant). Check with /helpers.
HELPER_BOT_TOKENS=
SPLIT_SIZE_MB=1950
MAX_RUNNING_PER_USER=5
MAX_WAITING_PER_USER=20
MAX_URLS_PER_MESSAGE=25
PROBE_CONCURRENCY=5
PLAYLIST_LIMIT=15
