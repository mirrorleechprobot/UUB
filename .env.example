BOT_TOKEN=YOUR_BOT_TOKEN
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
ADMIN_ID=123456789
# Optional extra admins (comma separated)
ADMIN_IDS=
# Log channel: bot ko channel me Admin banao (Post Messages). ID -100xxxxxxxxxx format me.
# (Bina -100 ke number daloge to bot khud theek kar lega.) Khali = log channel band.
LOG_CHANNEL_ID=-1001234567890
PORT=8080
DATA_DIR=/app/data
COOKIE_FILE=/app/cookies.txt
# Optional: Netscape cookies yahan paste karo (Koyeb secret env). Secret rakho.
COOKIES_TEXT=
# Optional: Referer jo kuch hosts mangte hain
DIRECT_REFERER=
PROGRESS_UPDATE_INTERVAL=10
MAX_RETRIES=3
# ---- speed tuning ----
MAX_CONCURRENT_JOBS=10
ARIA2_CONNECTIONS=16
ARIA2_DISK_CACHE_MB=64
CONCURRENT_FRAGMENTS=32
MAX_CONCURRENT_TRANSMISSIONS=6
# Upload: connections per big file x parts in flight per connection. Tune with /speedtest 400 <conns> <workers>
UPLOAD_CONNECTIONS=8
UPLOAD_WORKERS_PER_CONNECTION=4
UPLOAD_ADAPTIVE=true
# ---- FloodWait ----
# Waits up to FLOOD_SLEEP_THRESHOLD seconds are slept through automatically (same request is retried, no re-upload).
# Longer waits up to FLOOD_MAX_WAIT are waited out by the bot (user sees a message). Longer than that -> job fails cleanly.
FLOOD_SLEEP_THRESHOLD=600
FLOOD_MAX_WAIT=3600
# ---- multi bot (optional) ----
# Extra bot tokens, comma separated. EVERY helper must be Admin (Post Messages) of LOG_CHANNEL_ID, like the main bot.
# Helpers upload into the log channel and the main bot copies the file to the user (instant). Check with /helpers.
HELPER_BOT_TOKENS=
SPLIT_SIZE_MB=1950
MAX_RUNNING_PER_USER=1
MAX_WAITING_PER_USER=50
MAX_URLS_PER_MESSAGE=50
PROBE_CONCURRENCY=5
PLAYLIST_LIMIT=15

# ======================= v4 =======================
# ---- MongoDB (recommended on Koyeb: the disk is wiped on every redeploy) ----
# Atlas free M0 cluster -> Database Access: create a user -> Network Access: allow 0.0.0.0/0 -> Connect -> Drivers -> copy the URI.
MONGO_URI=
MONGO_DB=uub
PERSIST_SESSION=true            # peer cache in the DB so restored jobs / reminders can reach users after a redeploy
# ---- queue ----
PIPELINE=true                   # next file downloads while the previous one uploads (per user)
QUEUE_RESTORE_MAX_AGE_H=24
MAX_RUNNING_PER_USER=1
MAX_WAITING_PER_USER=50
MAX_URLS_PER_MESSAGE=50
# ---- cache / tuning / safety ----
CACHE_ENABLED=true
CACHE_TTL_DAYS=30
AUTOTUNE=true
SESSION_REUSE=true
SSRF_PROTECTION=true
DISK_MIN_FREE_MB=300
# ---- maintenance ----
YTDLP_UPDATE_HOURS=12           # 0 = off
ALERTS=true
# ---- torrents ----
TORRENT_ENABLED=true
TORRENT_NO_PEER_TIMEOUT=180
TORRENT_MAX_GB=8
# ---- premium plans (0 = unlimited; admins are never limited; per-user override: /setquota) ----
DAILY_LIMIT_GB=0
DAILY_LIMIT_FILES=0
PREMIUM_REMIND_DAYS=3,1

# ======================= v5 =======================
# ---- keep-alive: bot apne PUBLIC url ko har N minute me ping karta hai (free host sleep na kare) ----
KEEPALIVE_MINUTES=4             # 0 = off
KEEPALIVE_URL=                  # https://<your-app>.koyeb.app/health   (KOYEB_PUBLIC_DOMAIN mile to khud banta hai)
# ---- disk auto-clean ----
DISK_CLEAN_PERCENT=90           # disk itna % bhar jaye to safe auto-clean (running jobs / 2 min se taaza files nahi chhute)
